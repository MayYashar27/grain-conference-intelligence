# ─────────────────────────────────────────────────────────────────────────────
# Grain Conference Intelligence — environment configuration
# Copy this file to `.env` and fill in real values. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Client config — SAFE to expose. These are compiled into the browser bundle by
# Vite (the VITE_ prefix opts them in). The anon/publishable key is protected by
# Row Level Security, which only permits reads.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server ONLY — SECRET. Never prefixed with VITE_, never sent to the browser,
# never committed. Used exclusively by the write endpoint (api/conferences.ts)
# and the matching local dev middleware. Locally, place it in `.env.local`.
# In production, set it in Vercel → Project → Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server ONLY — SECRET. Powers AI discovery (api/discover.ts). Read only in the
# server context; never exposed to the browser. Locally place it in `.env.local`;
# in production set it in Vercel env vars.
GEMINI_API_KEY=your-gemini-api-key
# Optional — overrides the model (defaults to gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash
# Optional — faster model for the pass-2 structuring step only (defaults to GEMINI_MODEL).
# GEMINI_STRUCTURE_MODEL=
# Optional — model for the follow-up email draft (defaults to GEMINI_STRUCTURE_MODEL/GEMINI_MODEL).
# GEMINI_DRAFT_MODEL=
# Optional — how many conferences discovery asks for per run (defaults to 6).
# GEMINI_MAX_CANDIDATES=6
